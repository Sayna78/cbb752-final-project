gatk -T VariantRecalibrator -R <local>/$REFBASE --input <tmp>/recal.SNPs.vcf.gz -recalFile <tmp>/raw.Indels.recal \
   -tranchesFile <tmp>/raw.Indels.tranches $INDELOPT \
